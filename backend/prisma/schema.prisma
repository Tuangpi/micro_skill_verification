// Prisma schema for the Myanmar Micro-Course & Skill Verification Portal.
//
// T002 establishes the foundation only. Models are added as the tasks that own
// them are implemented; see docs/DATA_MODEL_AND_API.md for the full plan.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Accounts and roles. Password hashing uses scrypt (Node crypto). Sessions are
// backed by express-session + connect-pg-simple (see `Session`). Password-reset
// records are single-use and stored hashed (see `PasswordResetToken`).

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  name         String   @db.VarChar(120)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokens            PasswordResetToken[]
  teacherProfile         TeacherProfile?
  reviewedTeacherProfiles TeacherProfile[] @relation("TeacherProfileReviewer")
  auditLogs              AuditLog[]
  courses                Course[]
  mediaAssets            MediaAsset[]
  purchases              Purchase[]
  lessonProgress         LessonProgress[]
  paymentSubmissions     PaymentSubmission[]
  reviewedPaymentSubmissions PaymentSubmission[] @relation("PaymentSubmissionReviewer")
  enrollments            Enrollment[]

  @@map("users")
}

// connect-pg-simple session store table (auto-created if missing; tracked here
// so Prisma migrations own the schema).
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model TeacherProfile {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @unique @db.Uuid
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?                  @db.Text
  expertise    String?                  @db.VarChar(255)
  portfolioUrl String?                  @db.VarChar(500)
  status       TeacherApplicationStatus @default(PENDING)
  appliedAt    DateTime                 @default(now())
  reviewedAt   DateTime?
  reviewedById String?                  @db.Uuid
  reviewedBy   User?                    @relation("TeacherProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?                  @db.Text
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status])
  @@map("teacher_profiles")
}

enum CourseStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  DOCUMENT
  OTHER
}
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(120)
  targetType String   @db.VarChar(80)
  targetId   String   @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

model Course {
  id           String        @id @default(uuid()) @db.Uuid
  teacherId    String        @db.Uuid
  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title        String        @db.VarChar(200)
  slug         String        @unique @db.VarChar(220)
  description  String?       @db.Text
  priceMmk     Int           @map("price_mmk")
  status       CourseStatus  @default(DRAFT)
  coverMediaId String?       @db.Uuid
  coverMedia   MediaAsset?   @relation("CourseCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  sections     CourseSection[]
  purchases    Purchase[]
  enrollments  Enrollment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([teacherId])
  @@index([status])
  @@map("courses")
}

model CourseSection {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(200)
  position  Int      @default(0)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id              String        @id @default(uuid()) @db.Uuid
  sectionId       String        @db.Uuid
  section         CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title           String        @db.VarChar(200)
  description     String?       @db.Text
  position        Int           @default(0)
  videoProvider   String?       @db.VarChar(60)
  videoRef        String?       @db.VarChar(500)
  durationSeconds Int?
  isPreview       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  progress        LessonProgress[]
  updatedAt       DateTime      @updatedAt

  @@index([sectionId])
  @@map("lessons")
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @db.Uuid
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storageKey   String   @db.VarChar(500)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(120)
  sizeBytes    Int
  kind         MediaKind @default(OTHER)
  createdAt    DateTime @default(now())

  coveredCourses    Course[] @relation("CourseCover")
  paymentSubmissions PaymentSubmission[]

  @@index([ownerId])
  @@map("media_assets")
}

enum PurchaseStatus {
  PENDING
  PAYMENT_SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentProvider {
  KBZPAY
  WAVEPAY
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Purchase {
  id        String         @id @default(uuid()) @db.Uuid
  studentId String         @db.Uuid
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String         @db.Uuid
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  priceMmk  Int
  status    PurchaseStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  paymentSubmissions PaymentSubmission[]
  enrollment         Enrollment?

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("purchases")
}

model PaymentSubmission {
  id                   String                  @id @default(uuid()) @db.Uuid
  purchaseId           String                  @db.Uuid
  purchase             Purchase                @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  submittedById        String                  @db.Uuid
  submittedBy          User                    @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  provider             PaymentProvider
  transactionReference String                  @unique @db.VarChar(120)
  receiptMediaId       String?                 @db.Uuid
  receiptMedia         MediaAsset?             @relation(fields: [receiptMediaId], references: [id], onDelete: SetNull)
  status               PaymentSubmissionStatus @default(PENDING)
  reviewNote           String?                 @db.Text
  reviewedById         String?                 @db.Uuid
  reviewedBy           User?                   @relation("PaymentSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([purchaseId])
  @@index([status])
  @@map("payment_submissions")
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @db.Uuid
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  purchaseId String  @unique @db.Uuid
  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @db.Uuid
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId        String   @db.Uuid
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  positionSeconds Int      @default(0)
  completed       Boolean  @default(false)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

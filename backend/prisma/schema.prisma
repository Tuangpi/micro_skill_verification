// Prisma schema for the Myanmar Micro-Course & Skill Verification Portal.
//
// T002 establishes the foundation only. Models are added as the tasks that own
// them are implemented; see docs/DATA_MODEL_AND_API.md for the full plan.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Accounts and roles. Password hashing, sessions, and password-reset records
// are owned by T003 and are intentionally not modelled yet.

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(320)
  name      String   @db.VarChar(120)
  passwordHash String @db.VarChar(255)
  role      UserRole @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

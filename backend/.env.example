# Backend environment configuration.
# Copy to `.env` and adjust for your machine. Never commit real secrets.

# Runtime
NODE_ENV=development
PORT=4000

# API
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (same-origin deployment in production).
ALLOWED_ORIGINS=http://localhost:5173

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Database
# PostgreSQL connection string. Keep credentials out of source control.
DATABASE_URL=postgresql://micro_skill:change-me@127.0.0.1:5432/micro_skill_dev

# Private local file storage (owned by later tasks; safe placeholder for now).
STORAGE_ROOT=./var/storage

# Sessions (T003). Generate a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=168
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10

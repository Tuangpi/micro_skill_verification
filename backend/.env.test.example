# Test environment configuration.
# The test suite runs against a separate database so it can never touch
# development data. Create it once with:
#   createdb --owner micro_skill micro_skill_test
NODE_ENV=test
PORT=4001
API_PREFIX=/api/v1
ALLOWED_ORIGINS=
LOG_LEVEL=silent
DATABASE_URL=postgresql://micro_skill:micro_skill@127.0.0.1:5432/micro_skill_test
STORAGE_ROOT=./var/storage-test
TRUST_PROXY=false
